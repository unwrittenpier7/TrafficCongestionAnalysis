# ============================================================================
# TrafficSense configuration example
# Copy this file to `.env` and edit the values. NEVER commit a real `.env`.
# The application also works with plain environment variables, so a `.env`
# file is optional for the local demonstration.
# ============================================================================

# ------------------------------------------------------------------ Backend --
# Comma-separated list of frontend origins allowed by CORS.
# Do NOT use "*" in production. Default (unset) allows local dev origins only.
TRAFFICSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the trained model, metrics and cached road graphs live.
# Defaults to `<backend>/artifacts`. Set this to a persistent volume on hosts
# with an ephemeral filesystem (see README "Deployment").
# TRAFFICSENSE_ARTIFACTS_DIR=/var/lib/trafficsense/artifacts

# ------------------------------------------------- Road network (OSMnx) ----
# Study area used by POST /api/routes. Overriding this lets you move the demo
# to another city. Coordinates are "latitude,longitude".
TRAFFICSENSE_STUDY_AREA_NAME=Gachibowli, Hyderabad (demo study area)
TRAFFICSENSE_STUDY_POINT=17.44,78.35
# Radius around the study point, in metres. Keep this small: large radii are
# slow to download and put load on the public Overpass API.
TRAFFICSENSE_STUDY_DIST=600
TRAFFICSENSE_NETWORK_TYPE=drive

# Disable network downloads entirely (serve only a pre-cached graph).
# Useful for offline demos and CI.
# TRAFFICSENSE_OFFLINE=1

# ----------------------------------------------------------------- Frontend -
# Base URL of the backend API. Empty means "same origin" (use the Vite proxy
# in development). Set this at build time for a static deployment.
# VITE_API_BASE_URL=https://trafficsense-api.example.com
# VITE_PROXY_TARGET=http://127.0.0.1:8000
