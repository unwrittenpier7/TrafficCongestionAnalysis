# ------------------------------------- Generated artifacts and datasets ----
# The trained model and metrics are regenerated by `python -m app.train`.
# They are intentionally NOT committed: the joblib file is tens of MB and the
# dataset is a third-party download. See README "Model artifacts" section.
backend/artifacts/*.joblib
backend/artifacts/*.pkl
backend/artifacts/osm_cache/
backend/data/*.csv
backend/data/*.zip
backend/data/*.xlsx

